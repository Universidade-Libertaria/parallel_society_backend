rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // auth_nonces:
    // Only the backend (Functions) should write/read these.
    // However, since Functions use Admin SDK, they bypass these rules.
    // We strictly deny all access from the client SDKs.
    match /auth_nonces/{walletAddress} {
      allow read, write: if false;
    }

    // users:
    // Users can read their own profile.
    // Creation and updates are handled by the backend.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only Admin SDK (backend)
    }

    // Proposals collection
    match /proposals/{proposalId} {
      allow read: if true; // Public listing
      allow write: if false; // Managed by backend functions

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true; // Public
        allow write: if false; // Managed by backend functions

        // Comment votes subcollection
        match /votes/{voterId} {
          allow read: if true;
          allow write: if false; // Managed by backend functions
        }
      }

      // Revisions subcollection
      match /revisions/{revisionId} {
        allow read: if true; // Public
        allow write: if false; // Managed by backend functions
      }

      // Implementation updates subcollection
      match /updates/{updateId} {
        allow read: if true; // Public
        allow write: if false; // Managed by backend functions
      }
    }

    // Legacy proposalUpdates (top-level, read-only for backward compatibility)
    match /proposalUpdates/{updateId} {
      allow read: if true;
      allow write: if false; // No more writes to legacy collection
    }

    // Reports collection (for comment moderation)
    match /reports/{reportId} {
      allow read: if false; // Admin only
      allow write: if false; // Managed by backend functions
    }
  }
}
